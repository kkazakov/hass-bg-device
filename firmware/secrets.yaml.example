# Copy this file to firmware/secrets.yaml and fill in real values.
# firmware/secrets.yaml is git-ignored.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
api_encryption_key: "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

ota_password: "CHANGE_ME"

# Password for the fallback captive-portal AP; at least 8 characters.
ap_password: "fallback123"

# Same value as the gateway's BGV_API_KEY. Leave empty for a keyless gateway.
gateway_api_key: ""
